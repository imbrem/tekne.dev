{
	"hosting": {
		"public": "build",
		"cleanUrls": true,
		"redirects": [
			{
				"source": "/blog/locally-nameless-stlc",
				"destination": "/blog/adventures-in-type-theory/locally-nameless-stlc",
				"type": 301
			},
			{
				"source": "/blog/coming-in-clutch",
				"destination": "/blog/adventures-in-type-theory/coming-in-clutch",
				"type": 301
			},
			{
				"source": "/blog/scraping-by",
				"destination": "/blog/adventures-in-type-theory/scraping-by",
				"type": 301
			},
			{
				"source": "/blog/ship-of-thesis",
				"destination": "/blog/adventures-in-type-theory/ship-of-thesis",
				"type": 301
			},
			{
				"source": "/blog/paper-planes",
				"destination": "/blog/adventures-in-type-theory/paper-planes",
				"type": 301
			}
		],
		"rewrites": [
			{
				"source": "/ert.pdf",
				"destination": "/cas/ebec31ef1bdbf55b263842c2d39cf8782b0c761f7157be465628c2797afe6801"
			},
			{
				"source": "/papers/explicit-refinement-types.pdf",
				"destination": "/cas/ebec31ef1bdbf55b263842c2d39cf8782b0c761f7157be465628c2797afe6801"
			}
		],
		"headers": [
			{
				"source": "/**",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "max-age=60"
					}
				]
			},
			{
				"source": "/ert.pdf",
				"headers": [
					{
						"key": "Content-Type",
						"value": "application/pdf"
					},
					{
						"key": "Content-Disposition",
						"value": "inline; filename=\"ert.pdf\""
					}
				]
			},
			{
				"source": "/papers/explicit-refinement-types.pdf",
				"headers": [
					{
						"key": "Content-Type",
						"value": "application/pdf"
					},
					{
						"key": "Content-Disposition",
						"value": "inline; filename=\"explicit-refinement-types.pdf\""
					}
				]
			},
			{
				"source": "/cas/**",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "public, max-age=31536000, immutable"
					},
					{
						"key": "Content-Type",
						"value": "application/octet-stream"
					}
				]
			}
		],
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
	}
}
